const state={user:null,branch:null,branches:[],menu:[],cart:[],category:'All',payment:'CASH',orderType:'DINE_IN',bench:'Bench 1',online:navigator.onLine,offlineQueue:[]};
const $=s=>document.querySelector(s);const money=n=>'₹'+Number(n||0).toLocaleString('en-IN',{minimumFractionDigits:2,maximumFractionDigits:2});
async function api(url,opt={}){const r=await fetch(url,{credentials:'same-origin',...opt,headers:{'Content-Type':'application/json',...(opt.headers||{})}});const d=await r.json().catch(()=>({}));if(!r.ok)throw Error(d.error||'Request failed');return d;}
function toast(t){const x=document.createElement('div');x.className='toast';x.textContent=t;document.body.appendChild(x);requestAnimationFrame(()=>x.classList.add('show'));setTimeout(()=>{x.classList.remove('show');setTimeout(()=>x.remove(),250)},2300)}
function hideSplash(){setTimeout(()=>$('#splash')?.classList.add('hide'),2100)}
function pathBranch(){const m=location.pathname.match(/^\/b\/([^/]+)\/pos/);return m?m[1]:null}
function login(){document.body.innerHTML=`<div class="login"><div class="loginVisual"><img src="/brand/logo-primary.jpg" alt="Sri Ganapathy Andhra's Ruchulu"></div><div class="loginCard"><form class="loginBox" id="loginForm"><div class="loginLogo"><img src="/brand/logo-icon.jpg"><div><b>Sri Ganapathy</b><small>ANDHRA'S RUCHULU · POS</small></div></div><h1>Welcome back</h1><p>Secure counter access. Sign in to continue.</p><div class="field"><label>USERNAME</label><input id="loginUser" autocomplete="off" spellcheck="false" required></div><div class="field"><label>PASSWORD</label><div class="passwordWrap"><input id="loginPass" type="password" autocomplete="off" spellcheck="false" required><button type="button" id="showPass">Show</button></div></div><button class="loginSubmit">Sign in</button><div id="loginError" class="loginError"></div></form></div></div>`;
$('#showPass').onclick=()=>{const p=$('#loginPass');p.type=p.type==='password'?'text':'password';$('#showPass').textContent=p.type==='password'?'Show':'Hide'};
$('#loginForm').onsubmit=async e=>{e.preventDefault();$('#loginError').textContent='';try{let branchId=null;const slug=pathBranch();if(slug){const b=await api('/api/public/branch/'+encodeURIComponent(slug));branchId=b.id}await api('/api/auth/login',{method:'POST',body:JSON.stringify({username:$('#loginUser').value.trim(),password:$('#loginPass').value,branchId})});location.reload()}catch(err){$('#loginError').textContent=err.message}};hideSplash()}
async function init(){try{if("serviceWorker" in navigator)navigator.serviceWorker.register("/sw.js").catch(()=>{});const me=await api('/api/me');state.user=me.user;state.branches=await api('/api/branches');const slug=pathBranch();state.branch=slug?state.branches.find(b=>b.slug===slug):state.branches.find(b=>b.id===me.user.branchId)||state.branches[0];if(!state.branch)throw Error('No branch assigned');await loadMenu();renderApp();connectRealtime();loadOfflineQueue();flushOfflineQueue();hideSplash()}catch(e){login()}}
async function loadMenu(){state.menu=await api('/api/menu?branchId='+encodeURIComponent(state.branch.id));}
function renderApp(){document.body.innerHTML=`<div id="offline" class="offline ${state.online?'':'show'}">OFFLINE MODE · orders will sync when connection returns</div><div class="app"><aside class="side"><div class="brand"><img src="/brand/logo-icon.jpg"><div><b>Sri Ganapathy</b><small>ANDHRA'S RUCHULU</small></div></div><div class="branch"><label>ACTIVE BRANCH</label><select id="branchSelect">${state.branches.map(b=>`<option value="${b.id}" ${b.id===state.branch.id?'selected':''}>${b.name}</option>`).join('')}</select></div><nav class="nav"><button class="active" data-page="billing"><i>▣</i><span>POS / Billing</span></button><button data-page="orders"><i>☷</i><span>Orders</span><b class="badge" id="pendingBadge">0</b></button><button data-page="kitchen"><i>▤</i><span>Kitchen Display</span></button><button data-page="menu"><i>◈</i><span>Menu Items</span></button><button data-page="reports"><i>▥</i><span>Reports</span></button><button data-page="expenses"><i>₹</i><span>Expenses</span></button><button data-page="printers"><i>▤</i><span>Printers</span></button><button data-page="settings"><i>⚙</i><span>Settings</span></button><button data-page="staff"><i>♙</i><span>Staff</span></button><button data-page="admin"><i>⌂</i><span>Main Admin</span></button></nav><div class="sidefoot">Signed in as<b>${state.user.name}</b>${state.user.branch?state.user.branch.name:'All branches'}</div></aside><section class="main"><header class="top"><input id="search" class="search" placeholder="Search items or scan barcode here…"><div class="topmode"><button class="active" data-order-type="DINE_IN">▣ Dine In</button><button data-order-type="TAKE_AWAY">▢ Take Away</button><button data-order-type="DELIVERY">▣ Delivery</button></div><div class="topright">${state.branch.name}<b id="clock"></b></div></header><main id="content"></main></section><aside class="right"><div class="righthead"><div class="tabs"><button class="active" data-order-type="DINE_IN">Dine In</button><button data-order-type="TAKE_AWAY">Take Away</button><button data-order-type="DELIVERY">Delivery</button></div><div class="location"><b id="benchLabel">Bench 01⌄</b><button class="guest">♙ 1 Guest</button></div></div><div id="cart" class="cart"></div><div class="note">＋ Add order note</div><div id="totals" class="totals"></div></aside></div><div id="modalRoot"></div>`;
wireNav();renderBilling();tick();setInterval(tick,1000);$('#search').oninput=renderProducts;$('#search').onkeydown=scanBarcode;$('#branchSelect').onchange=async e=>{state.branch=state.branches.find(b=>b.id===e.target.value);state.cart=[];await loadMenu();renderBilling();toast('Switched to '+state.branch.name)};document.querySelectorAll('[data-order-type]').forEach(b=>b.onclick=()=>{state.orderType=b.dataset.orderType;document.querySelectorAll('[data-order-type]').forEach(x=>x.classList.toggle('active',x.dataset.orderType===state.orderType));});}
function tick(){const x=$('#clock');if(x)x.textContent=new Date().toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'})}
function wireNav(){document.querySelectorAll('[data-page]').forEach(b=>b.onclick=()=>{document.querySelectorAll('[data-page]').forEach(x=>x.classList.remove('active'));b.classList.add('active');loadPage(b.dataset.page)})}
async function loadPage(page){if(page==='billing'){renderBilling();return}if(page==='admin'){location.href='/admin/';return}const c=$('#content');if(page==='orders'){c.innerHTML=`<div class="ordersPage"><div class="pageTitle"><h2>Orders</h2><button onclick="renderBilling()">+ New Bill</button></div><div class="tableView"><table><thead><tr><th>Bill</th><th>Source</th><th>Location</th><th>Amount</th><th>Status</th><th>Time</th></tr></thead><tbody id="ordersRows"></tbody></table></div></div>`;const rows=await api('/api/orders?branchId='+state.branch.id);$('#ordersRows').innerHTML=rows.map(o=>`<tr><td><button class="linkBtn" onclick="openBill('${o.id}')">${o.invoiceNumber||o.number}</button></td><td>${o.source}</td><td>${o.bench?.label||'Counter'}</td><td>${money(o.total)}</td><td>${o.status}</td><td>${new Date(o.createdAt).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'})}</td></tr>`).join('');return}if(page==='kitchen'){await renderKds();return}if(page==='menu'){await renderMenuAdmin();return}if(page==='reports'){await renderReports();return}if(page==='expenses'){await renderExpenses();return}if(page==='printers'){await renderPrinters();return}if(page==='settings'){await renderSettings();return}if(page==='staff'){await renderStaff();return}}
function renderBilling(){const c=$('#content');c.innerHTML=`<div class="page"><div id="cats" class="cats"></div><div class="hero"><div class="heroContent"><small>SRI GANAPATHY SPECIAL</small><h1>Andhra Meals</h1><p>Fast counter service with clean branch-wise control, live QR ordering and reliable billing.</p><button onclick="addById(${state.menu[0]?.id?`'${state.menu[0].id}'`:''})">${state.menu[0]?money(state.menu[0].price):'₹0'} · Add Meal</button></div></div><div class="section"><div><h2 id="catTitle">Meals</h2><span id="itemCount"></span></div><div class="filters"><button class="filter active" data-filter="All">All</button><button class="filter" data-filter="Veg">Veg</button><button class="filter" data-filter="Non-Veg">Non-Veg</button></div></div><div id="products" class="products"></div><div class="section"><h2 style="font-size:15px">Quick Actions</h2></div><div class="quick"><button onclick="holdOrder()"><b>Ⅱ</b>Hold Order</button><button onclick="toast('Split bill workflow opened')"><b>✂</b>Split Bill</button><button onclick="toast('Merge order workflow opened')"><b>↔</b>Merge Orders</button><button onclick="discountModal()"><b>%</b>Discount</button><button onclick="printCurrentKOT()"><b>▤</b>Print KOT</button></div></div>`;renderCats();renderProducts();renderCart()}
function renderCats(){const cats=['All',...new Set(state.menu.map(x=>x.category))];$('#cats').innerHTML=cats.map(c=>`<button class="cat ${state.category===c?'active':''}" onclick="setCat('${c.replace(/'/g,"\\'")}')"><strong>${iconFor(c)}</strong>${c}</button>`).join('')}
function iconFor(c){return ({Meals:'🍛',Biryani:'🍲',Tiffins:'🥣',Starters:'🍗',Curries:'🥘',Beverages:'☕',Desserts:'🍮',Combos:'🍱'})[c]||'🍽️'}
window.setCat=c=>{state.category=c;renderCats();renderProducts()};window.addById=id=>{if(id)add(id)};
function renderProducts(){const q=($('#search')?.value||'').trim().toLowerCase();let list=state.menu.filter(x=>(state.category==='All'||x.category===state.category)&&(x.name+' '+(x.description||'')).toLowerCase().includes(q));$('#catTitle').textContent=state.category;$('#itemCount').textContent=`${list.length} items`;$('#products').innerHTML=list.map(p=>`<article class="food"><div class="foodimg">${iconFor(p.category)}</div><div class="foodbody"><h3>${p.name}</h3><p>${p.description||''}</p><div class="foodfoot"><b>${money(p.price)}</b><button class="add" onclick="add('${p.id}')">＋ Add</button></div></div></article>`).join('')||'<div style="padding:30px;color:#7d878e;font-size:10px">No active items match your search.</div>';document.querySelectorAll('[data-filter]').forEach(b=>b.onclick=()=>{document.querySelectorAll('[data-filter]').forEach(x=>x.classList.remove('active'));b.classList.add('active');const f=b.dataset.filter;if(f==='All'){state.menu=state.menu.slice()}renderProducts()})}
window.add=id=>{const c=state.cart.find(x=>x.id===id);if(c)c.quantity++;else state.cart.push({menuItemId:id,quantity:1});renderCart()};window.changeQty=(id,d)=>{const c=state.cart.find(x=>x.menuItemId===id);if(!c)return;c.quantity+=d;if(c.quantity<1)state.cart=state.cart.filter(x=>x.menuItemId!==id);renderCart()};
function renderCart(){const cart=$('#cart'),tot=$('#totals');if(!cart||!tot)return;cart.innerHTML=state.cart.map(c=>{const p=state.menu.find(x=>x.id===c.menuItemId);return `<div class="cartrow"><div class="thumb">${iconFor(p.category)}</div><div><h4>${p.name}</h4><div class="qty"><button onclick="changeQty('${p.id}',-1)">−</button><span>${c.quantity}</span><button onclick="changeQty('${p.id}',1)">＋</button></div></div><div class="cartprice">${money(Number(p.price)*c.quantity)}<button class="delete" onclick="changeQty('${p.id}',-99)">×</button></div></div>`}).join('')||'<div style="padding:50px 8px;text-align:center;color:#8a9399;font-size:10px">No items yet.<br>Add a meal to start billing.</div>';const subtotal=state.cart.reduce((a,c)=>{const p=state.menu.find(x=>x.id===c.menuItemId);return a+Number(p.price)*c.quantity},0);const tax=state.branch.taxEnabled?subtotal*Number(state.branch.taxRate)/100:0;const total=subtotal+tax;tot.innerHTML=`<div class="line"><span>Subtotal</span><b>${money(subtotal)}</b></div><div class="line"><span>Tax ${state.branch.taxEnabled?`(${state.branch.taxRate}%)`:''}</span><b>${money(tax)}</b></div><div class="line grand"><span>Total</span><b>${money(total)}</b></div><div class="pay"><button class="${state.payment==='CASH'?'active':''}" onclick="state.payment='CASH';renderCart()">Cash</button><button class="${state.payment==='UPI'?'active':''}" onclick="state.payment='UPI';renderCart()">UPI</button><button class="${state.payment==='CARD'?'active':''}" onclick="state.payment='CARD';renderCart()">Card</button></div><button class="place" onclick="placeOrder()">Place Bill · F2</button><div class="actions"><button onclick="holdOrder()">Hold</button><button onclick="openBillList()">Bills</button><button onclick="openPrinterSettings()">Print</button></div>`}
window.placeOrder=async()=>{if(!state.cart.length){toast('Add at least one item');return}const body={branchId:state.branch.id,source:'POS',paymentMethod:state.payment,lines:state.cart,clientRequestId:crypto.randomUUID()};try{let o;if(navigator.onLine)o=await api('/api/pos/orders',{method:'POST',body:JSON.stringify(body)});else{o=await queueOffline(body);toast('Saved locally. Will sync automatically.');state.cart=[];renderCart();return}state.cart=[];renderCart();toast('Bill '+(o.invoiceNumber||o.number)+' created');openBill(o.id);try{await api('/api/print-jobs',{method:'POST',body:JSON.stringify({orderId:o.id,type:'RECEIPT'})})}catch{} }catch(e){toast(e.message)}};
async function openBill(id){window.open('/api/orders/'+id+'/pdf','_blank','noopener');}window.openBill=openBill;function openBillList(){loadPage('orders')}
function holdOrder(){localStorage.setItem('held_'+state.branch.id,JSON.stringify(state.cart));state.cart=[];renderCart();toast('Order held on this terminal')}
function discountModal(){toast('Discount approval can be configured by role in Admin')}
function printCurrentKOT(){toast('Add items and place the order before printing KOT')}
function openPrinterSettings(){loadPage('printers')}
async function renderKds(){const c=$('#content');c.innerHTML=`<div class="ordersPage"><div class="pageTitle"><h2>Kitchen Display</h2><button onclick="renderKds()">Refresh</button></div><div id="kdsGrid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:9px"></div></div>`;const rows=await api('/api/orders?branchId='+state.branch.id);const active=rows.filter(o=>['PENDING','ACCEPTED','PREPARING','READY'].includes(o.status));$('#kdsGrid').innerHTML=active.map(o=>`<article style="background:#fff;border:1px solid #e0e5e7;border-radius:9px;padding:12px"><small style="color:#7c868e">${o.source} · ${o.bench?.label||'Counter'}</small><h3 style="font-size:14px;margin:5px 0">#${o.number}</h3><p style="font-size:9px;line-height:1.5">${o.lines.map(l=>`${l.menuItem.name} × ${l.quantity}`).join('<br>')}</p><b style="font-size:9px">${o.status}</b><div style="margin-top:9px;display:flex;gap:4px">${['ACCEPTED','PREPARING','READY','SERVED'].map(s=>`<button class="btn" onclick="setStatus('${o.id}','${s}')">${s}</button>`).join('')}</div></article>`).join('')||'<p style="font-size:10px;color:#879098">Kitchen queue is clear.</p>'}
window.setStatus=async(id,status)=>{await api('/api/orders/'+id+'/status',{method:'PATCH',body:JSON.stringify({status})});renderKds()}
async function renderMenuAdmin(){const c=$('#content');const rows=await api('/api/menu?branchId='+state.branch.id);c.innerHTML=`<div class="ordersPage"><div class="pageTitle"><h2>Menu Items</h2><button onclick="menuAdd()">+ Add item</button></div><div class="tableView"><table><thead><tr><th>Item</th><th>Category</th><th>Price</th><th>Barcode</th><th>Status</th><th></th></tr></thead><tbody>${rows.map(x=>`<tr><td>${x.name}</td><td>${x.category}</td><td>${money(x.price)}</td><td>${x.barcode||'—'}</td><td>${x.active?'Active':'Disabled'}</td><td><button class="linkBtn" onclick="menuEdit('${x.id}',${JSON.stringify(x).replace(/</g,'&lt;')})">Edit</button></td></tr>`).join('')}</tbody></table></div></div>`}
window.menuAdd=()=>menuForm();window.menuEdit=(id,x)=>menuForm(x);function menuForm(x={}){const m=document.createElement('div');m.className='modalBack show';m.innerHTML=`<div class="modal"><h2>${x.id?'Edit':'Add'} menu item</h2><p>Menu changes apply to this branch immediately after save.</p><div class="formgrid"><div class="field"><label>Name</label><input id="mName" value="${x.name||''}"></div><div class="field"><label>Category</label><input id="mCat" value="${x.category||'Meals'}"></div><div class="field"><label>Price</label><input id="mPrice" type="number" step="0.01" value="${x.price||''}"></div><div class="field"><label>Barcode</label><input id="mBar" autocomplete="off" spellcheck="false" value="${x.barcode||''}"></div><div class="field"><label>HSN</label><input id="mHsn" value="${x.hsnCode||''}"></div><div class="field"><label>Active</label><select id="mActive"><option value="true" ${x.active!==false?'selected':''}>Yes</option><option value="false" ${x.active===false?'selected':''}>No</option></select></div><div class="field" style="grid-column:1/-1"><label>Description</label><input id="mDesc" value="${x.description||''}"></div></div><div class="modalActions"><button class="btn" onclick="this.closest('.modalBack').remove()">Cancel</button><button class="btn primary" id="saveMenu">Save</button></div></div>`;document.body.appendChild(m);$('#saveMenu').onclick=async()=>{const body={name:$('#mName').value.trim(),category:$('#mCat').value.trim(),price:Number($('#mPrice').value),barcode:$('#mBar').value.trim()||null,hsnCode:$('#mHsn').value.trim()||null,description:$('#mDesc').value.trim(),active:$('#mActive').value==='true'};try{await api(x.id?'/api/menu/'+x.id:'/api/menu',{method:x.id?'PATCH':'POST',body:JSON.stringify(body)});m.remove();await loadMenu();renderMenuAdmin();toast('Menu saved')}catch(e){toast(e.message)}}}
async function renderReports(){const c=$('#content');const d=await api('/api/dashboard?branchId='+state.branch.id);c.innerHTML=`<div class="ordersPage"><div class="pageTitle"><h2>Today's report</h2><button onclick="renderReports()">Refresh</button></div><div class="statgrid"><div class="stat"><small>Sales</small><b>${money(d.sales)}</b></div><div class="stat"><small>Orders</small><b>${d.orders}</b></div><div class="stat"><small>Expenses</small><b>${money(d.expenses)}</b></div><div class="stat"><small>Pending</small><b>${d.pending}</b></div></div><div class="tableView" style="margin-top:12px"><table><thead><tr><th>Metric</th><th>Value</th></tr></thead><tbody><tr><td>QR Orders</td><td>${d.qrOrders}</td></tr><tr><td>Net before other adjustments</td><td>${money(d.sales-d.expenses)}</td></tr></tbody></table></div></div>`}
async function renderExpenses(){const c=$('#content');c.innerHTML=`<div class="ordersPage"><div class="pageTitle"><h2>Expenses</h2><button onclick="expenseForm()">+ Add expense</button></div><div class="tableView"><table><thead><tr><th>Title</th><th>Category</th><th>Amount</th><th>Date</th></tr></thead><tbody id="expenseRows"></tbody></table></div></div>`;const d=await api('/api/dashboard?branchId='+state.branch.id);$('#expenseRows').innerHTML=`<tr><td>Today's total</td><td>Summary</td><td>${money(d.expenses)}</td><td>Today</td></tr>`}
window.expenseForm=()=>{const title=prompt('Expense title');if(!title)return;const category=prompt('Category','Supplies')||'Other';const amount=Number(prompt('Amount','0'));if(!amount)return;api('/api/expenses',{method:'POST',body:JSON.stringify({title,category,amount,branchId:state.branch.id})}).then(()=>{toast('Expense added');renderExpenses()}).catch(e=>toast(e.message))}
async function renderPrinters(){const c=$('#content');const rows=await api('/api/printers?branchId='+state.branch.id);c.innerHTML=`<div class="ordersPage"><div class="pageTitle"><h2>Thermal Printers</h2><button onclick="printerForm()">+ Add printer</button></div><p style="font-size:9px;color:#7e878f">Use an ESC/POS network printer with the local print agent for unattended printing. Browser Web Serial is available only on supported HTTPS browsers.</p><div class="tableView"><table><thead><tr><th>Name</th><th>Width</th><th>Connection</th><th>Host</th><th>Status</th></tr></thead><tbody>${rows.map(p=>`<tr><td>${p.name}</td><td>${p.paperWidth}mm</td><td>${p.connection}</td><td>${p.host||'—'}</td><td>${p.active?'Active':'Disabled'}</td></tr>`).join('')}</tbody></table></div></div>`}
window.printerForm=async()=>{const name=prompt('Printer name','Receipt Printer 01');if(!name)return;const host=prompt('LAN IP (optional)','192.168.1.100')||undefined;const port=Number(prompt('Port','9100'))||9100;try{const p=await api('/api/printers',{method:'POST',body:JSON.stringify({name,type:'THERMAL',connection:host?'LAN':'AGENT',host,port,paperWidth:80,copies:1,receiptOn:true,kotOn:true,branchId:state.branch.id})});alert('Printer created. Agent token:\n'+p.agentToken);renderPrinters()}catch(e){toast(e.message)}}
async function renderSettings(){const b=await api('/api/branches/'+state.branch.id+'/settings');const c=$('#content');c.innerHTML=`<div class="ordersPage"><div class="pageTitle"><h2>Branch settings</h2><button onclick="saveSettings()">Save changes</button></div><div class="modal" style="width:100%;box-shadow:none;border:1px solid var(--line)"><div class="formgrid"><div class="field"><label>Business name</label><input id="sName" value="${b.name}"></div><div class="field"><label>Phone</label><input id="sPhone" value="${b.phone||''}"></div><div class="field"><label>GSTIN</label><input id="sGst" value="${b.gstin||''}"></div><div class="field"><label>Invoice prefix</label><input id="sPrefix" value="${b.invoicePrefix}"></div><div class="field"><label>Invoice title</label><input id="sTitle" value="${b.invoiceTitle}"></div><div class="field"><label>Receipt width</label><select id="sWidth"><option ${b.receiptPaperWidth===80?'selected':''}>80</option><option ${b.receiptPaperWidth===58?'selected':''}>58</option></select></div><div class="field"><label>UPI ID</label><input id="sUpi" value="${b.upiId||''}" placeholder="name@bank"></div><div class="field"><label>UPI name</label><input id="sUpiName" value="${b.upiName||''}"></div><div class="field" style="grid-column:1/-1"><label>Receipt header</label><input id="sHeader" value="${b.receiptHeader||''}"></div><div class="field" style="grid-column:1/-1"><label>Receipt footer</label><input id="sFooter" value="${b.receiptFooter||''}"></div><div class="field"><label>Tax enabled</label><select id="sTax"><option value="false" ${!b.taxEnabled?'selected':''}>No</option><option value="true" ${b.taxEnabled?'selected':''}>Yes</option></select></div><div class="field"><label>Tax rate %</label><input id="sTaxRate" type="number" step="0.01" value="${b.taxRate||0}"></div></div></div><div class="section"><h2 style="font-size:14px">Account security</h2></div><button class="btn" onclick="changeOwnPassword()">Change my password</button></div>`}
window.saveSettings=async()=>{try{await api('/api/branches/'+state.branch.id,{method:'PATCH',body:JSON.stringify({name:$('#sName').value,phone:$('#sPhone').value,gstin:$('#sGst').value||null,invoicePrefix:$('#sPrefix').value,invoiceTitle:$('#sTitle').value,receiptPaperWidth:Number($('#sWidth').value),upiId:$('#sUpi').value||null,upiName:$('#sUpiName').value||null,receiptHeader:$('#sHeader').value,receiptFooter:$('#sFooter').value,taxEnabled:$('#sTax').value==='true',taxRate:Number($('#sTaxRate').value)})});await loadMenu();toast('Settings saved')}catch(e){toast(e.message)}}
window.changeOwnPassword=async()=>{const current=prompt('Current password');if(current===null)return;const next=prompt('New password (minimum 8 characters)');if(!next)return;try{await api('/api/me/password',{method:'PATCH',body:JSON.stringify({currentPassword:current,newPassword:next})});toast('Password changed')}catch(e){toast(e.message)}}
async function renderStaff(){const rows=await api('/api/users');const c=$('#content');c.innerHTML=`<div class="ordersPage"><div class="pageTitle"><h2>Staff & access</h2><button onclick="staffForm()">+ Add staff</button></div><div class="tableView"><table><thead><tr><th>Name</th><th>Username</th><th>Role</th><th>Branch</th><th>Status</th><th></th></tr></thead><tbody>${rows.map(u=>`<tr><td>${u.name}</td><td>${u.username}</td><td>${u.role}</td><td>${u.branch?.name||'All branches'}</td><td>${u.active?'Active':'Disabled'}</td><td><button class="linkBtn" onclick="resetStaff('${u.id}')">Reset password</button></td></tr>`).join('')}</tbody></table></div></div>`}
window.staffForm=async()=>{const name=prompt('Staff name');if(!name)return;const username=prompt('Username');if(!username)return;const password=prompt('Initial password (8+ chars)');if(!password)return;const role=prompt('Role: CASHIER / KITCHEN / MANAGER','CASHIER')||'CASHIER';try{await api('/api/users',{method:'POST',body:JSON.stringify({name,username,password,role,branchId:state.branch.id})});toast('Staff created');renderStaff()}catch(e){toast(e.message)}};window.resetStaff=async id=>{const p=prompt('New password (8+ chars)');if(!p)return;try{await api('/api/users/'+id+'/password',{method:'PATCH',body:JSON.stringify({password:p})});toast('Password reset')}catch(e){toast(e.message)}}
function connectRealtime(){const socket=io({transports:['websocket','polling']});socket.on('connect',()=>socket.emit('join:branch',state.branch.id));socket.on('order:new',o=>{if(o.branchId!==state.branch.id)return;$('#pendingBadge')?.replaceChildren(document.createTextNode('1'));const x=document.createElement('div');x.className='incoming';x.innerHTML=`<h3>New ${o.source==='QR'?'QR ':''}Order · ${o.bench?.label||'Counter'}</h3><p>Bill #${o.number}<br>${o.lines.map(l=>`${l.menuItem.name} × ${l.quantity}`).join('<br>')}</p><button>Accept & Send to Kitchen</button>`;x.querySelector('button').onclick=async()=>{await api('/api/orders/'+o.id+'/status',{method:'PATCH',body:JSON.stringify({status:'PREPARING'})});x.remove();toast('Order accepted')};document.body.appendChild(x);});socket.on('order:update',()=>{if($('#kdsGrid'))renderKds()})}
async function scanBarcode(e){if(e.key!=='Enter')return;const v=e.currentTarget.value.trim();if(!v)return;try{const p=await api('/api/menu/barcode/'+encodeURIComponent(v)+'?branchId='+state.branch.id);add(p.id);e.currentTarget.value='';toast(p.name+' added')}catch{toast('Barcode not found')}}
async function loadOfflineQueue(){try{state.offlineQueue=JSON.parse(localStorage.getItem('ganapathy_offline_orders')||'[]')}catch{state.offlineQueue=[]}}
async function queueOffline(body){state.offlineQueue.push(body);localStorage.setItem('ganapathy_offline_orders',JSON.stringify(state.offlineQueue));return {local:true}}
async function flushOfflineQueue(){if(!navigator.onLine||!state.offlineQueue.length)return;const keep=[];for(const body of state.offlineQueue){try{await api('/api/pos/orders',{method:'POST',body:JSON.stringify(body)})}catch{keep.push(body)}}state.offlineQueue=keep;localStorage.setItem('ganapathy_offline_orders',JSON.stringify(keep));if(!keep.length&&state.online)toast('Offline orders synced')}
window.add=window.add||add;window.changeQty=window.changeQty||changeQty;window.placeOrder=window.placeOrder||placeOrder;window.openBill=openBill;
window.addEventListener('online',()=>{state.online=true;$('#offline')?.classList.remove('show');flushOfflineQueue()});window.addEventListener('offline',()=>{state.online=false;$('#offline')?.classList.add('show')});
hideSplash();init();


